{
  "name": "@viliha/vui-ui",
  "version": "1.67.0",
  "description": "Vui UI is a free, token-driven React component library and admin dashboard template for Next.js and Tailwind CSS v4. It bundles the shadcn/ui set plus a full datatable, forms, charts, and auth screens, and ships as TypeScript source so your bundler compiles only what you import.",
  "license": "MIT",
  "author": "VILIHA PTE. LTD.",
  "homepage": "https://internal.viliha.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myviliha/vui-starter.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/myviliha/vui-starter/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "nextjs",
    "next.js",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "shadcn",
    "shadcn-ui",
    "radix",
    "radix-ui",
    "typescript",
    "admin",
    "admin-template",
    "admin-dashboard",
    "dashboard",
    "dashboard-template",
    "react-admin",
    "crm",
    "saas",
    "saas-template",
    "datatable",
    "data-table",
    "ui",
    "ui-kit",
    "component-library",
    "components",
    "design-system",
    "dark-mode",
    "mcp",
    "mcp-server"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "bin",
    "!bin/*.test.mjs",
    "template",
    "docs",
    "README.md",
    "AGENT.md",
    "CHANGELOG.md",
    "CLAUDE.template.md"
  ],
  "bin": {
    "vui-ui": "bin/vui.mjs",
    "vui": "bin/vui.mjs"
  },
  "exports": {
    "./theme.css": "./src/theme.css",
    "./utils": "./src/utils.ts",
    "./theme-config": "./src/theme-config.ts",
    "./*": "./src/*.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsgo --noEmit",
    "test": "vitest run",
    "sync-template": "node scripts/sync-template.mjs",
    "snapshot-docs": "node scripts/snapshot-docs.mjs",
    "release": "node scripts/publish.mjs",
    "prepublishOnly": "node scripts/guard-publish.mjs && node scripts/sync-template.mjs && node scripts/snapshot-docs.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@tanstack/charts": "^0.18.0"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/charts": "^0.18.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@tanstack/charts": {
      "optional": true
    }
  }
}
